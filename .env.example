PORT=5000
NODE_ENV=development

# Supabase — Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Used for signing/verifying JWTs
JWT_SECRET=

# Groq console → API Keys
GROQ_API_KEY=

# Redis (for background job queue). If running `npm run dev` directly on
# your machine with Redis via `docker compose up redis`, use localhost.
# (docker-compose.yml overrides this to REDIS_HOST=redis automatically
# when the backend itself also runs inside Docker Compose.)
REDIS_HOST=localhost
REDIS_PORT=6379
# In production (e.g. Upstash), set REDIS_URL instead (a single
# rediss://default:<password>@<host>:<port> string) — it takes priority
# over REDIS_HOST/REDIS_PORT when present. Leave blank locally.
REDIS_URL=

# Resend (resend.com) — for sending verification emails
RESEND_API_KEY=

# This backend's own public URL — used to build the link inside the
# verification email (e.g. `${BACKEND_URL}/api/auth/verify-email?token=...`).
# Locally this is your dev server; in production, set it to your Render URL.
BACKEND_URL=http://localhost:5000
